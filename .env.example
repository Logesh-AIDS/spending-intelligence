# ─── Copy this to .env and fill in values ───────────────────────────────────
# Never commit .env to git

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production

# ─── Backend ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql://spending_user:spending_pass@localhost:5432/spending_db
REDIS_URL=redis://localhost:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── PostgreSQL (for Docker) ──────────────────────────────────────────────────
POSTGRES_DB=spending_db
POSTGRES_USER=spending_user
POSTGRES_PASSWORD=spending_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── ML ──────────────────────────────────────────────────────────────────────
ML_MODELS_DIR=/app/ml/models
ML_DATA_DIR=/app/ml/data
